# Lakehouse and Airflow secrets. Do not copy this file: run `fleetforge env`
# (scripts/make-lakehouse-env.sh), which writes .env.lakehouse with random values and
# mode 600. The names below are what the compose files expect.
LAKEHOUSE_CATALOG_PASSWORD=<random>
LAKEHOUSE_S3_ACCESS_KEY=GK<24 hex>
LAKEHOUSE_S3_SECRET_KEY=<64 hex>
GARAGE_RPC_SECRET=<64 hex>
GARAGE_ADMIN_TOKEN=<random>
AIRFLOW_DB_PASSWORD=<random>
AIRFLOW_ADMIN_PASSWORD=<random>
AIRFLOW_JWT_SECRET=<64 hex>
AIRFLOW_FERNET_KEY=<urlsafe base64 of 32 random bytes>
